---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Morning Ashtanga Yoga (Mysore style) in Berlin with Elinore Burke" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href={import.meta.env.BASE_URL + "favicon.png"} />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Ashtanga Yoga Zentral</title>
	</head>
	<body>
		<Navigation />
		<main>
			<slot />
		</main>
		
		<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-col">
      <h3>Ashtanga Yoga Zentral</h3>
      <p>Morning Ashtanga Yoga (Mysore style) in Berlin with Elinore Burke.</p>
    </div>
    <div class="footer-col">
      <h4>Location</h4>
      <p>Three Boons Studio<br/>Brunnen Str. 29/3 (Hinterhof)<br/>Berlin</p>
    </div>
    <div class="footer-col">
      <h4>Links</h4>
      <a href={import.meta.env.BASE_URL + "about"}>About Elinore</a>
      <a href={import.meta.env.BASE_URL + "retreats"}>Retreats & Events</a>
      <a href={import.meta.env.BASE_URL + "contact"}>Contact</a>
      <a href={import.meta.env.BASE_URL + "imprint"}>Imprint</a>
      <a href={import.meta.env.BASE_URL + "gdpr"}>Datenschutz (GDPR)</a>
    </div>
  </div>
  <div class="footer-bottom">
    <p>&copy; {new Date().getFullYear()} Ashtanga Yoga Zentral. All rights reserved.</p>
  </div>
		</footer>
	</body>
</html>

<!-- Styles moved to global.css or dedicated CSS components -->
<!-- This section was removed to prevent duplication with global styles -->
<!-- If specific layout styles are needed, they should be defined in src/styles/global.css -->
<!-- The main styling for the layout remains in the Astro/global.css structure. -->
<style>
/* Keeping minimal styles necessary for the layout component structure */
main {
    /* Placeholder for min-height if needed, but better handled by global CSS */
}

</style>