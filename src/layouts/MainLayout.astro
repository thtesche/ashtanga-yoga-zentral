---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
    title: string; // Dies sollte idealerweise der lokalisierte Titel sein
}

const { title } = Astro.props;
---

<!doctype html>
<html lang={Astro.currentLocale || 'en'}>
    <head>
        <meta charset="UTF-8" />
        <!-- Lokalisierte Beschreibung verwenden -->
        <meta name="description" content="Morning Ashtanga Yoga (Mysore style) in Berlin with Elinore Burke - {/* Dynamischer Text basierend auf der Seite */} " /> 
        <meta name="viewport" content="width=device-width" />
        <!-- ... andere Meta Tags -->
        <title>{title} | Ashtanga Yoga Zentral</title>
    </head>
    <body>
        <Navigation />
        <main>
            <slot />
        </main>
        
        <footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-col">

      <h3>Ashtanga Yoga Zentral</h3> 
      <p>{/* Dynamischer Text */} </p>
    </div>
    <div class="footer-col">
      <h4>Location</h4> 
      <p>Three Boons Studio<br/>Brunnen Str. 29/3 (Hinterhof)<br/>Berlin</p>
    </div>
    <div class="footer-col">
      <h4>Links</h4> 
      <a href={getRelativeLocaleUrl(Astro.currentLocale || 'en', 'about')}>About Elinore</a>
      <a href={getRelativeLocaleUrl(Astro.currentLocale || 'en', 'retreats')}>Retreats & Events</a>
      <a href={getRelativeLocaleUrl(Astro.currentLocale || 'en', 'contact')}>Contact</a>
      <a href={getRelativeLocaleUrl(Astro.currentLocale || 'en', 'imprint')}>Imprint</a>
      <a href={getRelativeLocaleUrl(Astro.currentLocale || 'en', 'gdpr')}>Datenschutz (GDPR)</a>
    </div>
  </div >
  <div class="footer-bottom">
    <p>&copy; {new Date().getFullYear()} Ashtanga Yoga Zentral. All rights reserved.</p>
  </div>
</footer>
</body>
</html>

<style>
/* Keeping minimal styles necessary for the layout component structure */
main {
    /* Placeholder for min-height if needed, but better handled by global CSS */
}

</style>