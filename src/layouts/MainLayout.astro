---
import '../styles/global.css';
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/outfit/500.css';
import '@fontsource/outfit/600.css';

import inter300Url from '@fontsource/inter/files/inter-latin-300-normal.woff2?url';
import inter400Url from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import outfit500Url from '@fontsource/outfit/files/outfit-latin-500-normal.woff2?url';
import outfit600Url from '@fontsource/outfit/files/outfit-latin-600-normal.woff2?url';

import Navigation from '../components/Navigation.astro';
import { i18nData, getLocalizedLink } from '../components/i18n-config.astro';

interface Props {
    title: string;
    description?: string;
}

const { title, description } = Astro.props;
const currentLang = (Astro.currentLocale || 'en') as keyof typeof i18nData;
const currentFooter = i18nData[currentLang].footer;
---

<!doctype html>
<html lang={currentLang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={description || "Morning Ashtanga Yoga (Mysore style) in Berlin with Elinore Burke"} />
        <meta name="viewport" content="width=device-width" />
        <!-- Preload critical fonts to break the request chain -->
        <link rel="preload" href={inter300Url} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={inter400Url} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={outfit500Url} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={outfit600Url} as="font" type="font/woff2" crossorigin />
        <!-- ... andere Meta Tags -->
        <title>{title} | Ashtanga Yoga Zentral</title>

        <!-- Google Tag Manager (GA4) -->
        <script is:inline src="//www.googletagmanager.com/gtag/js?id=G-DMTRVZQ6QD" data-cfasync="false" data-wpfc-render="false" async></script>
        <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());

            gtag('config', 'G-DMTRVZQ6QD');
        </script>

        <!-- Client-side Language Redirect for SSG -->
        <script is:inline>
            (function() {
                const path = window.location.pathname;
                // Check if we are on the root path (considering base path)
                // The base path is '/ashtanga-yoga-zentral/'
                const basePath = '/ashtanga-yoga-zentral';
                const isRoot = path === '/' || path === basePath + '/';

                if (isRoot) {
                    const supportedLocales = ['de', 'en'];
                    const browserLang = navigator.language.split('-')[0]; // e.g., 'de-DE' -> 'de'

                    if (supportedLocales.includes(browserLang) && browserLang !== 'en') {
                        window.location.replace(basePath + '/' + browserLang + '/');
                    } else {
                        // Default to English if no match or English is preferred
                        window.location.replace(basePath + '/en/');
                    }
                }
            })();
        </script>
    </head>
    <body>
        <Navigation />
        <main>
            <slot />
        </main>
        
        <footer class="site-footer">
          <div class="container footer-container">
            <div class="footer-col">
              <h3>Ashtanga Yoga Zentral</h3>
              <p>Morning Ashtanga Yoga in Berlin</p>
            </div>
            <div class="footer-col">
              <h4>{currentFooter.location}</h4>
              <p>Three Boons Studio<br/>Brunnen Str. 29/3 (Hinterhof)<br/>Berlin</p>
            </div>
          </div>

          <div class="footer-col">
            <div class="footer-legal-links">
              <a href={getLocalizedLink(currentLang, currentFooter.contact.path)}>{currentFooter.contact.label}</a>
              <a href={getLocalizedLink(currentLang, currentFooter.legalNotice.path)}>{currentFooter.legalNotice.label}</a>
              <a href={getLocalizedLink(currentLang, currentFooter.gdpr.path)}>{currentFooter.gdpr.label}</a>
            </div>
          </div>
        </footer>
    </body>
</html>

<style>
/* Keeping minimal styles necessary for the layout component structure */
main {
    /* Placeholder for min-height if needed, but better handled by global CSS */
}

.footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    margin-top: 2rem;
}

.footer-legal-links {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
    background-color: #ffffff;
    padding: 1rem 2rem;
    border-radius: 8px;
    box-shadow: var(--shadow-sm);
}

.footer-legal-links a {
    font-size: 1rem;
    text-decoration: underline;
    color: var(--color-primary);
    transition: color var(--transition-fast);
}

.footer-legal-links a:hover {
    color: var(--color-text);
}
</style>
