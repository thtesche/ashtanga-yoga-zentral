---
import '../styles/global.css';
import '@fontsource/inter';
import '@fontsource/outfit';
import Navigation from '../components/Navigation.astro';
import { i18nData, getLocalizedLink } from '../components/i18n-config.astro';

interface Props {
    title: string; // Dies sollte idealerweise der lokalisierte Titel sein
}

const { title } = Astro.props;
const currentLang = (Astro.currentLocale || 'en') as keyof typeof i18nData;
const currentFooter = i18nData[currentLang].footer;
---

<!doctype html>
<html lang={currentLang}>
    <head>
        <meta charset="UTF-8" />
        <!-- Lokalisierte Beschreibung verwenden -->
        <meta name="description" content="Morning Ashtanga Yoga (Mysore style) in Berlin with Elinore Burke - {/* Dynamischer Text basierend auf der Seite */} " /> 
        <meta name="viewport" content="width=device-width" />
        <!-- ... andere Meta Tags -->
        <title>{title} | Ashtanga Yoga Zentral</title>
    </head>
    <body>
        <Navigation />
        <main>
            <slot />
        </main>
        
        <footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-col">

      <h3>Ashtanga Yoga Zentral</h3> 
      <p>{/* Dynamischer Text */} </p>
    </div>
    <div class="footer-col">
      <h4>{currentFooter.location}</h4> 
      <p>Three Boons Studio<br/>Brunnen Str. 29/3 (Hinterhof)<br/>Berlin</p>
    </div>
    </div >
  <div class="footer-col">
    <div class="footer-legal-links">
      <a href={getLocalizedLink(currentLang, currentFooter.contact.path)}>{currentFooter.contact.label}</a>
      <a href={getLocalizedLink(currentLang, currentFooter.imprint.path)}>{currentFooter.imprint.label}</a>
      <a href={getLocalizedLink(currentLang, currentFooter.gdpr.path)}>{currentFooter.gdpr.label}</a>
    </div>
</div>
</footer>
</body>
</html>

<style>
/* Keeping minimal styles necessary for the layout component structure */
main {
    /* Placeholder for min-height if needed, but better handled by global CSS */
}

.footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    margin-top: 2rem;
}

.footer-legal-links {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
    background-color: #ffffff;
    padding: 1rem 2rem;
    border-radius: 8px;
    box-shadow: var(--shadow-sm);
}

.footer-legal-links a {
    font-size: 1rem;
    text-decoration: underline;
    color: var(--color-primary);
    transition: color var(--transition-fast);
}

.footer-legal-links a:hover {
    color: var(--color-text);
}
</style>