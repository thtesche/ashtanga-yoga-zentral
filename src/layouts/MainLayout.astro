---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import { i18nData, getLocalizedLink } from '../components/i18n-config.astro';

interface Props {
    title: string; // Dies sollte idealerweise der lokalisierte Titel sein
}

const { title } = Astro.props;
const currentLang = Astro.currentLocale || 'en';
const currentFooter = i18nData[currentLang].footer;
---

<!doctype html>
<html lang={currentLang}>
    <head>
        <meta charset="UTF-8" />
        <!-- Lokalisierte Beschreibung verwenden -->
        <meta name="description" content="Morning Ashtanga Yoga (Mysore style) in Berlin with Elinore Burke - {/* Dynamischer Text basierend auf der Seite */} " /> 
        <meta name="viewport" content="width=device-width" />
        <!-- ... andere Meta Tags -->
        <title>{title} | Ashtanga Yoga Zentral</title>
    </head>
    <body>
        <Navigation />
        <main>
            <slot />
        </main>
        
        <footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-col">

      <h3>Ashtanga Yoga Zentral</h3> 
      <p>{/* Dynamischer Text */} </p>
    </div>
    <div class="footer-col">
      <h4>{currentFooter.location}</h4> 
      <p>Three Boons Studio<br/>Brunnen Str. 29/3 (Hinterhof)<br/>Berlin</p>
    </div>
    <div class="footer-col">
      <h4>{currentFooter.links}</h4> 
      <a href={getLocalizedLink(currentLang, 'about')}>{currentFooter.about}</a>
      <a href={getLocalizedLink(currentLang, 'retreats')}>{currentFooter.retreats}</a>
      <a href={getLocalizedLink(currentLang, 'contact')}>{currentFooter.contact}</a>
      <a href={getLocalizedLink(currentLang, 'imprint')}>{currentFooter.imprint}</a>
      <a href={getLocalizedLink(currentLang, 'gdpr')}>{currentFooter.gdpr}</a>
    </div>
  </div >
  <div class="footer-bottom">
    <p>&copy; {new Date().getFullYear()} Ashtanga Yoga Zentral. {currentFooter.copyright}</p>
  </div>
</footer>
</body>
</html>

<style>
/* Keeping minimal styles necessary for the layout component structure */
main {
    /* Placeholder for min-height if needed, but better handled by global CSS */
}

</style>