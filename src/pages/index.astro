---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Morning Ashtanga Yoga Berlin">
  <section class="hero-section section">
    <div class="container hero-container animate-fade-in">
      <h1>Morning Ashtanga Yoga <br/><span class="text-primary">(Mysore style)</span> in Berlin</h1>
      <p class="hero-subtitle">Begin your day with clarity, steadiness, and breath. The classes are open to practitioners of all levels, including complete beginners.</p>
      <div class="hero-actions">
        <a href="/contact" class="btn">Get in Touch</a>
        <a href="#schedule" class="btn btn-outline">View Schedule</a>
      </div>
    </div>
  </section>

  <section class="intro-section section bg-light">
    <div class="container animate-fade-in-delay">
      <div class="surface text-center">
        <h2 class="text-primary">Welcome to the Shala</h2>
        <p class="large-text">We offer a quiet, supportive space to receive personal guidance within the shared energy of the group. If you're new to yoga, allow around 30 minutes for the first class.</p>
      </div>
    </div>
  </section>

  <section id="schedule" class="schedule-section section">
    <div class="container">
      <div class="grid-2-col">
        <div class="surface">
          <h2 class="text-secondary">Class Schedule</h2>
          <ul class="schedule-list">
            <li>
              <strong>Monday &ndash; Friday</strong>
              <span>6:30 &ndash; 9:00 am</span>
            </li>
            <li>
              <strong>Sunday <span class="badge">(Except <a href="/moon-days">Moon Days</a>)</span></strong>
              <span>7:30 &ndash; 9:30 am</span>
            </li>
            <li class="highlight-item">
              <strong>Led Primary Class <span class="badge">Last Friday of month</span></strong>
              <span>7:00 &ndash; 8:30 am</span>
            </li>
          </ul>
        </div>
        
        <div class="surface">
          <h2 class="text-secondary">Location</h2>
          <div class="location-card">
            <h3>Three Boons Studio</h3>
            <p>Brunnen Str. 29/3 (Hinterhof)<br/>10119 Berlin</p>
            <a href="https://maps.google.com/?q=Three+Boons+Studio+Brunnen+Str.+29/3+Berlin" target="_blank" rel="noopener noreferrer" class="btn btn-outline mt-1">View on Map</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="pricing-section section bg-light">
    <div class="container">
      <h2 class="text-center text-primary mb-3">Prices & Memberships</h2>
      
      <div class="pricing-grid">
        <div class="surface pricing-card">
          <h3>Trial Month</h3>
          <div class="price">&euro;90</div>
          <p class="text-muted">Unlimited classes for beginners only.</p>
        </div>
        
        <div class="surface pricing-card highlight-card">
          <div class="badge-top">Most Popular</div>
          <h3>Unlimited Month</h3>
          <div class="price">&euro;135</div>
          <p class="text-muted">Practice as often as you like.</p>
        </div>
        
        <div class="surface pricing-card">
          <h3>12x Month</h3>
          <div class="price">&euro;115</div>
          <p class="text-muted">Perfect for 3 times a week.</p>
        </div>

        <div class="surface pricing-card">
          <h3>8x Month</h3>
          <div class="price">&euro;95</div>
          <p class="text-muted">Perfect for 2 times a week.</p>
        </div>
      </div>
      
      <div class="surface mt-3 text-center additional-pricing">
        <div class="grid-2-col">
          <div>
            <h4>Drop-In</h4>
            <p>&euro;20 <span class="text-muted">(with established practice)</span></p>
          </div>
          <div>
            <h4>Visiting Berlin Pass</h4>
            <p>&euro;80 <span class="text-muted">(1 week unlimited, with established practice)</span></p>
          </div>
        </div>
        <hr class="divider" />
        <p class="discount-note">Discount available due to financial difficulties. Please get in touch using the form on the <a href="/contact">Contact</a> page.</p>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .hero-section {
    padding: 8rem 0 6rem;
    background: linear-gradient(to bottom, var(--color-bg), #F2EBE1);
    text-align: center;
  }
  
  .hero-container h1 {
    font-size: 4rem;
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }

  .text-primary { color: var(--color-primary); }
  .text-secondary { color: var(--color-secondary); }
  .text-muted { color: #777; font-size: 0.9rem; }
  .text-center { text-align: center; }
  .bg-light { background-color: #F8F5F0; }
  .mb-3 { margin-bottom: 3rem; }
  .mt-1 { margin-top: 1rem; }
  .mt-3 { margin-top: 3rem; }

  .hero-subtitle {
    font-size: 1.25rem;
    max-width: 700px;
    margin: 0 auto 2.5rem;
    color: #4A5550;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
  }

  .large-text {
    font-size: 1.2rem;
    max-width: 800px;
    margin: 0 auto;
  }

  .grid-2-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .schedule-list {
    list-style: none;
    padding: 0;
  }

  .schedule-list li {
    display: flex;
    flex-direction: column;
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .schedule-list li:last-child {
    border-bottom: none;
  }

  .schedule-list strong {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .badge {
    font-size: 0.75rem;
    background: var(--color-bg);
    padding: 0.2rem 0.5rem;
    border-radius: 12px;
    font-weight: normal;
    color: var(--color-text);
  }

  .highlight-item {
    background-color: rgba(194, 109, 92, 0.05);
    padding: 1rem;
    border-radius: 8px;
    margin-top: 1rem;
    border-bottom: none !important;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
  }

  .pricing-card {
    text-align: center;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .price {
    font-size: 2.5rem;
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--color-primary);
    margin: 1rem 0;
  }

  .highlight-card {
    border: 2px solid var(--color-secondary);
    transform: translateY(-10px);
  }

  .highlight-card:hover {
    transform: translateY(-15px);
  }

  .badge-top {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-secondary);
    color: #fff;
    padding: 0.2rem 1rem;
    border-radius: 20px;
    font-size: 0.8rem;
    font-family: var(--font-heading);
    white-space: nowrap;
  }

  .divider {
    border: 0;
    height: 1px;
    background: var(--color-border);
    margin: 2rem 0;
  }

  .discount-note {
    font-style: italic;
    color: #666;
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .hero-container h1 { font-size: 2.5rem; }
    .grid-2-col { grid-template-columns: 1fr; }
    .hero-actions { flex-direction: column; }
    .highlight-card { transform: translateY(0); }
    .highlight-card:hover { transform: translateY(-5px); }
  }
</style>
