---
import { getCollection, render } from "astro:content";
import MainLayout from "../../components/MainLayout.astro";
import { mdxComponents } from "../../components";
import { getStructuredData } from "../../components/structured-data";

/**
 * Dynamic route for all German pages under /de/.
 * Serves every `de/*` entry from the `pages` content collection, including
 * the German index (empty slug).
 */
export async function getStaticPaths() {
  // Maps a collection id to the slug used under /de/ (index entries map to "").
  // Must live inside getStaticPaths: it is hoisted out of the frontmatter scope.
  const toSlug = (id: string) =>
    id === "index" || id === "de" ? "" : id.replace(/^de\//, "");
  const entries = await getCollection("pages");
  const deEntries = entries.filter(
    (entry) => entry.id === "de" || entry.id.startsWith("de/"),
  );
  const enEntries = entries.filter(
    (entry) => entry.id !== "de" && !entry.id.startsWith("de/"),
  );

  const paths = deEntries.map((entry) => ({
    params: { slug: toSlug(entry.id) },
  }));

  // Replicate Astro's i18n fallback (fallbackType: 'redirect'): for every
  // English page without a German counterpart, emit the locale-prefixed path.
  // The body below turns it into a meta-refresh redirect to the English page,
  // exactly like the fallback pages Astro generated for static routes.
  const deSlugs = new Set(deEntries.map((entry) => toSlug(entry.id)));
  for (const entry of enEntries) {
    const slug = toSlug(entry.id);
    if (!deSlugs.has(slug)) {
      paths.push({ params: { slug } });
    }
  }
  return paths;
}

const { slug = "" } = Astro.params;
const entries = await getCollection("pages");
const entry = entries.find((e) => e.id === (slug === "" ? "de" : `de/${slug}`));

if (!entry) {
  // No German page for this slug. If the English page exists, redirect to it —
  // same behavior as Astro's i18n fallback for missing DE routes.
  const hasEnglishCounterpart = entries.some(
    (e) => e.id === (slug === "" ? "index" : slug),
  );
  if (!hasEnglishCounterpart) {
    throw new Response(null, { status: 404 });
  }
  // Strip the /de locale segment from the current URL, preserving base and
  // trailing slash (e.g. /de/about/ -> /about/, or with a base prefix).
  const englishPath = Astro.url.pathname.replace(/\/de(?=\/|$)/, "");
  // Status 301 makes Astro emit an immediate meta-refresh (content="0;url=...")
  // in the static build. A delayed refresh (the default 302) is treated by
  // Google as a temporary redirect; an immediate one counts as permanent.
  // A true HTTP 301 is not possible on GitHub Pages (no _redirects/.htaccess).
  return Astro.redirect(englishPath, 301);
}

const { Content } = await render(entry);
---

<MainLayout
  title={entry.data.title}
  description={entry.data.description}
  fullTitle={entry.data.fullTitle}
  structuredData={getStructuredData(entry.id, entry.data)}
>
  <Content components={mdxComponents} />
</MainLayout>
