---
import MainLayout from "../components/MainLayout.astro";
import { getLocalizedLink } from "../components/i18n-config.astro";

// The 404 page is built once and served for every unknown path, so it
// renders in the default locale (EN). The noindex prop suppresses
// canonical + hreflang, which would otherwise point at non-existent URLs.
---

<MainLayout title="Page not found" noindex>
  <div class="page-header">
    <div class="container text-center animate-fade-in">
      <p class="error-code">404</p>
      <h1>Page not found</h1>
      <p class="subtitle">
        The page you are looking for doesn't exist or has been moved.
      </p>
    </div>
  </div>

  <section class="section">
    <div class="container text-center animate-fade-in-delay">
      <a class="btn" href={getLocalizedLink("en", "")}>Back to home</a>
    </div>
  </section>
</MainLayout>

<style>
  .page-header {
    background-color: var(--color-primary);
    color: #fff;
    padding: 6rem 0 4rem;
  }

  .page-header h1 {
    color: #fff;
    margin-bottom: 0.5rem;
  }

  .error-code {
    font-family: var(--font-heading);
    font-size: 5rem;
    font-weight: 600;
    line-height: 1;
    margin-bottom: 0.5rem;
    color: #ffffffe6;
  }

  .subtitle {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    color: #ffffffe6;
  }

  .text-center {
    text-align: center;
  }
</style>
