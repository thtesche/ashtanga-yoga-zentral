---
import { Image } from "astro:assets";
import { resolveImagePath } from "./image-assets.ts";

/**
 * Guest-teacher workshop card (used alongside retreats on the retreats page).
 *
 * Description is passed as slot content (Markdown); details as a plain string
 * array so AstroCMS can edit it in its table editor (one row per entry).
 */

/** Marker type: AstroCMS renders an image picker for props typed `ImagePath`. */
type ImagePath = string;

interface Props {
  /** Path to the card image, relative to the MDX file (e.g. ../../assets/images/foo.webp). */
  image?: ImagePath;
  /** Alt text for the card image. */
  imageAlt?: string;
  /** Workshop title. */
  title: string;
  /** Date range, rendered as muted text under the title. */
  date: string;
  /** Optional detail list (one entry per row, e.g. "Mysore Practice Week"). */
  details?: string[];
}

const {
  image,
  imageAlt = "",
  title,
  date,
  details = [],
} = Astro.props;

// Resolved at build time from the CMS path; null skips the image gracefully.
const src = resolveImagePath(image);
---

<article class="event-card surface">
  {src && (
    <Image src={src} alt={imageAlt} class="event-img" loading="lazy" />
  )}

  <h3>{title}</h3>
  <p class="date">{date}</p>

  <slot />

  {details.length > 0 && (
    <ul class="event-details">
      {details.map((item) => <li>{item}</li>)}
    </ul>
  )}
</article>

<style>
  .event-card {
    display: flex;
    flex-direction: column;
  }

  .event-img {
    width: 100%;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
    margin-bottom: 1.5rem;
  }

  .date {
    font-size: 0.9rem;
    color: #777;
    margin-bottom: 1rem;
  }

  .event-details {
    margin-top: 1.5rem;
    padding-left: 1.5rem;
    color: #4a5550;
  }

  .event-details li {
    margin-bottom: 0.5rem;
  }

  @media (max-width: 768px) {
    .event-details {
      padding-left: 1rem;
    }
  }
</style>
