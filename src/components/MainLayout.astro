---
import "../styles/global.css";
import "@fontsource/inter/300.css";
import "@fontsource/inter/400.css";
import "@fontsource/outfit/500.css";
import "@fontsource/outfit/600.css";

import inter300Url from "@fontsource/inter/files/inter-latin-300-normal.woff2?url";
import inter400Url from "@fontsource/inter/files/inter-latin-400-normal.woff2?url";
import outfit500Url from "@fontsource/outfit/files/outfit-latin-500-normal.woff2?url";
import outfit600Url from "@fontsource/outfit/files/outfit-latin-600-normal.woff2?url";

import Navigation from "../components/Navigation.astro";
import CookieConsent from "../components/CookieConsent.astro";
import JsonLd from "../components/JsonLd.astro";
import {
  i18nData,
  getLocalizedLink,
  getCounterpartSlug,
} from "../components/i18n-config.astro";
import { getAbsoluteLocaleUrl } from "astro:i18n";

interface Props {
  title: string;
  /**
   * Optional full <title> override. When set, the " | Ashtanga Yoga Zentral"
   * suffix is skipped (e.g. for titles that already contain the brand name).
   */
  fullTitle?: string;
  description?: string;
  structuredData?: any;
  /**
   * Optional canonical URL override. Defaults to a self-referencing
   * canonical built from the configured site (https + www), so EN/DE
   * duplicates and apex/non-www domain variants consolidate correctly.
   */
  canonical?: string;
  /**
   * For pages that should never be indexed (e.g. the 404 page): emits a
   * noindex meta tag and suppresses canonical + hreflang, which would
   * otherwise point at URLs that do not exist.
   */
  noindex?: boolean;
}

const {
  title,
  fullTitle,
  description,
  structuredData,
  canonical,
  noindex = false,
} = Astro.props;
// Derive locale from URL path. Astro.url.pathname includes base path.
// The German locale is identified by the /de prefix (not a substring match,
// so English slugs starting with "de" are not misdetected).
const rawPath = Astro.url?.pathname || "/";
const isGerman = rawPath === "/de" || rawPath.startsWith("/de/");
let currentLang: keyof typeof i18nData = isGerman ? "de" : "en";

// Locale-independent slug of the current page (e.g. /de/faq -> faq, / -> '')
const localizedPath = isGerman
  ? rawPath.replace(/^\/de(\/|$)/, "").replace(/\/$/, "")
  : rawPath.replace(/^\//, "").replace(/\/$/, "");

// Counterpart slugs for the hreflang tags: page pairs whose EN/DE slugs
// differ (e.g. gdpr <-> datenschutz) are mapped explicitly, see localeSlugMap.
const enHreflangSlug =
  currentLang === "de" ? getCounterpartSlug("de", localizedPath) : localizedPath;
const deHreflangSlug =
  currentLang === "en" ? getCounterpartSlug("en", localizedPath) : localizedPath;

// Self-referencing canonical: always points at this page's own locale URL
// on the configured site (unlike the hreflang tags, which use counterpart slugs).
const canonicalUrl =
  canonical ?? getAbsoluteLocaleUrl(currentLang, localizedPath);

const currentFooter = i18nData[currentLang].footer;

// Locale-aware fallback so a missing description never leaks the wrong language.
const defaultDescription =
  currentLang === "de"
    ? "Morgen-Ashtanga-Yoga (Mysore Style) in Berlin mit Elinore Burke"
    : "Morning Ashtanga Yoga (Mysore style) in Berlin with Elinore Burke";
---

<!doctype html>
<html lang={currentLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description || defaultDescription} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!
      noindex && (
        // Self-referencing canonical (normalizes domain + locale duplicates)
        <link rel="canonical" href={canonicalUrl} />
      )
    }
    <!-- Preload critical fonts to break the request chain -->
    <link
      rel="preload"
      href={inter300Url}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={inter400Url}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={outfit500Url}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={outfit600Url}
      as="font"
      type="font/woff2"
      crossorigin
    />
    {!
      noindex && (
        // Hreflang tags for SEO i18n (counterpart slugs via localeSlugMap)
        <>
          <link
            rel="alternate"
            hreflang="en"
            href={getAbsoluteLocaleUrl("en", enHreflangSlug)}
          />
          <link
            rel="alternate"
            hreflang="de"
            href={getAbsoluteLocaleUrl("de", deHreflangSlug)}
          />
          <link
            rel="alternate"
            hreflang="x-default"
            href={getAbsoluteLocaleUrl("en", enHreflangSlug)}
          />
        </>
      )
    }

    <title>{fullTitle ?? `${title} | Ashtanga Yoga Zentral`}</title>

    <!-- Google Tag Manager (GA4) - Loaded conditionally via CookieConsent -->
    <script is:inline>
      (function () {
        const CONSENT_KEY = "cookie_consent";
        const GTM_ID = "G-DMTRVZQ6QD";

        function loadGTM() {
          const script = document.createElement("script");
          script.async = true;
          script.src = `//www.googletagmanager.com/gtag/js?id=${GTM_ID}`;
          document.head.appendChild(script);

          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          gtag("js", new Date());
          gtag("config", GTM_ID);
        }

        const consent = localStorage.getItem(CONSENT_KEY);
        if (consent === "accepted") {
          loadGTM();
        } else {
          // Listen for the custom event from CookieConsent component
          window.addEventListener("cookieConsentAccepted", loadGTM);
        }
      })();
    </script>

    {structuredData && <JsonLd data={structuredData} />}

    <!-- No automatic browser-language redirect. Locale is derived from URL path. -->
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Navigation />
    <main id="main-content">
      <slot />
    </main>

    <CookieConsent currentLang={currentLang} />

    <footer class="site-footer">
      <div class="container footer-container">
        <div class="footer-col">
          <h3>Ashtanga Yoga Zentral</h3>
          <p>Morning Ashtanga Yoga in Berlin</p>
        </div>
        <div class="footer-col">
          <h4>{currentFooter.location}</h4>
          <p>
            Three Boons Studio<br />Brunnen Str. 29/3 (Hinterhof)<br />Berlin
          </p>
        </div>
      </div>

      <div class="footer-col">
        <div class="footer-legal-links">
          <a href={getLocalizedLink(currentLang, currentFooter.contact.path)}
            >{currentFooter.contact.label}</a
          >
          <a
            href={getLocalizedLink(currentLang, currentFooter.legalNotice.path)}
            >{currentFooter.legalNotice.label}</a
          >
          <a href={getLocalizedLink(currentLang, currentFooter.gdpr.path)}
            >{currentFooter.gdpr.label}</a
          >
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  /* Skip-to-content link */
  .skip-link {
    position: absolute;
    top: -100%;
    left: 0;
    background: var(--color-primary);
    color: #fff;
    padding: 0.75rem 1.5rem;
    z-index: 10000;
    font-family: var(--font-heading);
    text-decoration: none;
    border-radius: 0 0 4px 0;
  }

  .skip-link:focus {
    top: 0;
  }

  /* Keeping minimal styles necessary for the layout component structure */
  main {
    /* Placeholder for min-height if needed, but better handled by global CSS */
  }

  .footer-legal-links {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
    background-color: #ffffff;
    padding: 1rem 2rem;
    border-radius: 8px;
    box-shadow: var(--shadow-sm);
  }

  .footer-legal-links a {
    font-size: 1rem;
    text-decoration: underline;
    color: var(--color-primary);
    transition: color var(--transition-fast);
  }

  .footer-legal-links a:hover {
    color: var(--color-text);
  }
</style>
