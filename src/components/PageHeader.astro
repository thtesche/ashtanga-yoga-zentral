---
/**
 * Shared page header for all content pages (EN + DE).
 *
 * Replaces the duplicated `<div class="page-header">` markup that used to
 * live in 14 MDX files. All header styles (default + legal-page variant)
 * are scoped here, so the per-page CSS files no longer define them.
 *
 * Usage in MDX (no import needed — auto-discovered via mdxComponents):
 *   <PageHeader title="FAQ" subtitle="Frequently Asked Questions" />
 *   <PageHeader title="Privacy Policy" class="legal_header" />
 */
interface Props {
  /** Page heading (H1). */
  title: string;
  /** Optional line below the heading. Omit for header-only pages (e.g. GDPR). */
  subtitle?: string;
  /**
   * Header variant: "" = default dark header, "legal_header" = light
   * legal-page header (GDPR / Impressum). The "" literal is required so
   * AstroCMS renders a dropdown instead of free text (a single string
   * literal degrades to "string"); selecting it removes the attribute.
   */
  class?: '' | 'legal_header';
}

const { title, subtitle, class: variantClass } = Astro.props;
---

<div class:list={["page-header", variantClass]}>
  <div class="container text-center animate-fade-in">
    <h1>{title}</h1>
    {subtitle && <p class="subtitle">{subtitle}</p>}
  </div>
</div>

<style>
  /* Default variant: dark primary header. */
  .page-header {
    background-color: var(--color-primary);
    color: #fff;
    padding: 6rem 0 4rem;
  }

  .page-header h1 {
    color: #fff;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    color: #ffffffe6;
  }

  /* Light variant for the legal pages (GDPR / Impressum). Scoped like
     .page-header, so it must stay after it to win at equal specificity. */
  .legal_header {
    background-color: var(--color-info, #e9f1ff);
    color: #333;
    padding: 4rem 0 2rem;
  }

  .legal_header h1 {
    color: #0056b3;
    margin-bottom: 0.5rem;
  }
</style>
