---
import { Image } from 'astro:assets';
import { i18nData, getLocalizedLink } from './i18n-config.astro';
import logo from '../assets/images/logo.webp';
import flagEn from '../assets/images/flag-en.svg';
import flagDe from '../assets/images/flag-de.svg';

// Derive locale from URL path. Astro.url.pathname includes base path.
// Check if the path contains /de (works with or without base prefix).
const rawPath = Astro.url?.pathname || '/';
let currentLang: keyof typeof i18nData = rawPath.includes('/de') ? 'de' : 'en';
const currentNav = i18nData[currentLang].nav;

const navItems = [
  { key: 'home', label: currentNav.home.label, path: currentNav.home.path },
  { key: 'about', label: currentNav.about.label, path: currentNav.about.path },
  { key: 'retreats', label: currentNav.retreats.label, path: currentNav.retreats.path },
  { key: 'moonDays', label: currentNav.moonDays.label, path: currentNav.moonDays.path },
  { key: 'faq', label: currentNav.faq.label, path: currentNav.faq.path },
  { key: 'contact', label: currentNav.contact.label, path: currentNav.contact.path },
];
---

<nav class="main-nav">
  <div class="container nav-container">
    <a href={getLocalizedLink(currentLang, currentNav.home.path)} class="logo">
        <Image src={logo} alt="Ashtanga Yoga Zentral Logo" class="nav-logo-img" width={100} height={100} loading="eager"/>
      <div class="logo-text">
        <span>Ashtanga Yoga</span>
        <span>Zentral Berlin</span>
      </div>
    </a>
    
    <div class="nav-links" id="mobile-nav-links" role="menubar">
      {navItems.map(item => (
        <a href={getLocalizedLink(currentLang, item.path)} role="menuitem">{item.label}</a>
      ))}

      <div class="lang-switcher" role="menuitem">
        <a href={getLocalizedLink('en', currentNav.home.path)} class={currentLang === 'en' ? 'active' : ''} title="English">
          <Image src={flagEn} alt="EN" width="20" height="14" loading="eager" />
        </a>
        <a href={getLocalizedLink('de', currentNav.home.path)} class={currentLang === 'de' ? 'active' : ''} title="Deutsch">
          <Image src={flagDe} alt="DE" width="20" height="14" loading="eager" />
        </a>
      </div>
    </div>

    <!-- Mobile menu toggle -->
    <button
      class="mobile-menu-btn"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="mobile-nav-links"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </div>
</nav>

<script>
  let isOpen = false;
  let btn: HTMLButtonElement | null = null;
  let menu: HTMLElement | null = null;

  function openMenu() {
    isOpen = true;
    if (menu) menu.style.display = 'flex';
    if (btn) btn.setAttribute('aria-expanded', 'true');
  }

  function closeMenu() {
    isOpen = false;
    if (menu) menu.style.display = '';
    if (btn) btn.setAttribute('aria-expanded', 'false');
    if (btn) btn.focus();
  }

  function setupMobileMenu() {
    btn = document.querySelector('.mobile-menu-btn') as HTMLButtonElement | null;
    menu = document.querySelector('.nav-links') as HTMLElement | null;

    if (!btn || !menu) return;

    btn.addEventListener('click', () => {
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
        // Move focus to the currently active (current page) link
        const currentPath = window.location.pathname;
        const activeLink = Array.from(menu?.querySelectorAll('a') ?? [])
          .find(a => a.getAttribute('href')?.replace(/\/$/, '') === currentPath.replace(/\/$/, ''))
          ?? (menu?.querySelector('a') ?? null) as HTMLAnchorElement | null;
        if (activeLink) activeLink.focus();
      }
    });

    // Close on Escape and trap focus within the menu
    document.addEventListener('keydown', (e) => {
      if (!isOpen) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        closeMenu();
        return;
      }

      // Focus trap: Arrow keys cycle through links
      const links = Array.from(menu?.querySelectorAll('a') ?? []);
      if (links.length === 0) return;
      const active = document.activeElement as HTMLElement | null;
      const idx = links.indexOf(active);
      if (idx === -1) return;

      if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
        e.preventDefault();
        const next = links[(idx + 1) % links.length];
        if (next) next.focus();
      } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
        e.preventDefault();
        const prev = links[(idx - 1 + links.length) % links.length];
        if (prev) prev.focus();
      }
    });
  }

  // Run on initial load
  setupMobileMenu();

  // Run on Astro page transitions if they are used
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>

<style>
  .main-nav {
    background-color: var(--color-surface);
    padding: 1.25rem 0;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: var(--shadow-sm);
  }

  .nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
  }

  .nav-logo-img {
    height: 100px;
    width: auto;
    border-radius: 50%;
  }

  .logo-text {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--color-text);
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    text-align: center;
  }

  .logo-text span {
    font-size: inherit;
    color: inherit;
    font-weight: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-links a {
    font-family: var(--font-heading);
    color: var(--color-text);
    text-decoration: none;
    font-weight: 400;
    font-size: 1.05rem;
    transition: color var(--transition-fast);
  }

  .nav-links a:hover {
    color: var(--color-primary);
  }

  /* Mobile menu focus ring — always visible in mobile context */
  .nav-links a:focus {
    outline: 2px solid var(--color-primary);
    outline-offset: 0.25rem;
    border-radius: 0.125rem;
  }

  /* Desktop nav: show outline only on keyboard focus */
  @media (min-width: 769px) {
    .nav-links a:focus {
      outline: none;
    }
    .nav-links a:focus-visible {
      outline: 2px solid var(--color-primary);
      outline-offset: 0.25rem;
      border-radius: 0.125rem;
    }
  }

  .btn-nav {
    padding: 0.5rem 1.25rem;
    color: #fff !important;
  }

  .btn-nav:hover {
    color: #fff !important;
  }

  .mobile-menu-btn {
    display: none;
    background: none;
    border: none;
    color: var(--color-text);
    cursor: pointer;
  }

  @media (max-width: 768px) {
    .nav-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background-color: var(--color-surface);
      flex-direction: column;
      padding: 1rem 0;
      gap: 1rem;
      text-align: center;
      box-shadow: var(--shadow-sm);
    }
    
    .mobile-menu-btn {
      display: block;
    }
  }
</style>
