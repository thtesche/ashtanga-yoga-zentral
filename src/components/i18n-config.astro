---
import { getRelativeLocaleUrl } from "astro:i18n";

export type SupportedLocale = "en" | "de";

/**
 * Centralized i18n data for navigation and common UI elements.
 * This can be expanded to include footer links, button labels, etc.
 */
export const i18nData: Record<SupportedLocale, any> = {
  en: {
    nav: {
      home: { path: "", label: "Home" },
      about: { path: "about", label: "About Us" },
      retreats: { path: "retreats", label: "Retreats & Events" },
      moonDays: { path: "moondays", label: "Moondays" },
      faq: { path: "faq", label: "FAQ" },
      contact: { path: "contact", label: "Contact" },
    },
    footer: {
      location: "Location",
      links: "Links",
      contact: { path: "contact", label: "Contact" },
      legalNotice: { path: "legal_notice", label: "Legal Notice" },
      gdpr: { path: "gdpr", label: "Privacy Policy" },
      copyright: "All rights reserved.",
    },
    cookieConsent: {
      title: "Cookie Settings",
      message:
        "We use cookies to improve your experience. Technical cookies are necessary. We need your consent for Google Tag Manager.",
      accept: "Accept",
      decline: "Decline",
      changeSettings: "Change Cookie Settings",
    },
  },
  de: {
    nav: {
      home: { path: "", label: "Home" },
      about: { path: "ueber_uns", label: "Über uns" },
      retreats: { path: "retreats", label: "Retreats & Events" },
      moonDays: { path: "moondays", label: "Moondays" },
      faq: { path: "faq", label: "FAQ" },
      contact: { path: "kontakt", label: "Kontakt" },
    },
    footer: {
      location: "Standort",
      links: "Links",
      contact: { path: "kontakt", label: "Kontakt" },
      legalNotice: { path: "impressum", label: "Impressum" },
      gdpr: { path: "datenschutz", label: "Datenschutz" },
      copyright: "Alle Rechte vorbehalten.",
    },
    cookieConsent: {
      title: "Cookie-Einstellungen",
      message:
        "Wir verwenden Cookies, um Ihr Erlebnis zu verbessern. Technische Cookies sind erlaubt. Für Google Tag Manager benötigen wir Ihre Zustimmung.",
      accept: "Akzeptieren",
      decline: "Ablehnen",
      changeSettings: "Cookie-Einstellungen ändern",
    },
  },
};

export function getLocalizedLink(locale: string, path: string) {
  // Use Astro's getRelativeLocaleUrl for ALL locales — it computes the
  // correct relative path from the current page, respecting base + i18n
  // routing (prefixDefaultLocale: false). Using raw paths for 'en' caused
  // relative resolution bugs (e.g. /contact/moondays/ instead of /moondays/).
  if (!path || path === "") {
    // Home: link to locale root
    return getRelativeLocaleUrl(locale, "");
  }
  return getRelativeLocaleUrl(locale, path);
}

/**
 * Explicit slug mapping for page pairs whose EN and DE slugs differ.
 * Pages not listed here use the same slug in both locales (e.g. "faq", "").
 */
export const localeSlugMap: Record<SupportedLocale, Partial<Record<string, string>>> = {
  en: {
    about: "ueber_uns",
    contact: "kontakt",
    gdpr: "datenschutz",
    legal_notice: "impressum",
  },
  de: {
    ueber_uns: "about",
    kontakt: "contact",
    datenschutz: "gdpr",
    impressum: "legal_notice",
  },
};

/**
 * Returns the slug of the counterpart page in the other locale.
 * Falls back to the given slug when no explicit mapping exists
 * (same-slug pages like "faq" and the home page "").
 */
export function getCounterpartSlug(fromLocale: SupportedLocale, slug: string): string {
  return localeSlugMap[fromLocale][slug] ?? slug;
}
---
