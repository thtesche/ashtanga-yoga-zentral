---
import InfoTip from "./InfoTip.astro";

/**
 * A single pricing card: title, optional info tooltip and the price.
 *
 * Used inside PricingGrid on the home pages. The card is a surface itself
 * (`.pricing-card` overrides `.surface` padding), so both classes live here.
 */

interface Props {
  /** Card heading, e.g. "Trial Month". */
  title: string;
  /** Price, rendered as-is, e.g. "€90". */
  price: string;
  /** Optional tooltip text shown in the info marker next to the title. */
  tooltip?: string;
}

const { title, price, tooltip } = Astro.props;
---

<div class="surface pricing-card">
  <h3>
    {title}
    {tooltip && <InfoTip tip={tooltip} />}
  </h3>

  <div class="price">{price}</div>
</div>

<style>
  .pricing-card {
    text-align: center;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    padding: 1.5rem 1rem !important;
  }

  .pricing-card h3 {
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    flex-shrink: 0;
  }

  .price {
    font-size: 2.5rem;
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--color-primary);
    margin-top: auto;
  }
</style>
