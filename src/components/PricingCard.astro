---
/**
 * A single pricing card: title, optional info tooltip and the price.
 *
 * Used inside PricingGrid on the home pages. The card is a surface itself
 * (`.pricing-card` overrides `.surface` padding), so both classes live here.
 */

interface Props {
  /** Card heading, e.g. "Trial Month". */
  title: string;
  /** Price, rendered as-is, e.g. "€90". */
  price: string;
  /** Optional tooltip text shown in the info marker next to the title. */
  tooltip?: string;
}

const { title, price, tooltip } = Astro.props;
---

<div class="surface pricing-card">
  <h3>
    {title}
    {tooltip && <i class="info-tip" data-tip={tooltip}>i</i>}
  </h3>

  <div class="price">{price}</div>
</div>

<style>
  .pricing-card {
    text-align: center;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    padding: 1.5rem 1rem !important;
  }

  .pricing-card h3 {
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    flex-shrink: 0;
  }

  .info-tip {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.4rem;
    height: 1.4rem;
    border: 1.5px solid #999;
    border-radius: 50%;
    font-size: 0.8rem;
    font-style: normal;
    font-weight: 700;
    color: #999;
    cursor: help;
  }

  .info-tip::after {
    content: attr(data-tip);
    position: fixed;
    bottom: calc(100% + 0.5rem);
    left: 50%;
    transform: translateX(-50%);
    background: #333;
    color: #fff;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 400;
    font-style: normal;
    white-space: normal;
    width: 180px;
    text-align: center;
    line-height: 1.4;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s;
    z-index: 1000;
  }

  .info-tip:hover::after,
  .info-tip:focus::after {
    opacity: 1;
  }

  .price {
    font-size: 2.5rem;
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--color-primary);
    margin-top: auto;
  }
</style>
