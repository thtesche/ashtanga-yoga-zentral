---
interface Props {
  title?: string;
  buttonLabel: string;
}

const { title = "Cookie Settings", buttonLabel } = Astro.props;
---

<div class="mt-4 p-4 bg-gray-100 rounded">
  <p>
    <button id="reset-cookie-consent" class="text-primary underline">{buttonLabel}</button>
  </p>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    const btn = document.getElementById('reset-cookie-consent');
    if (btn) {
      btn.addEventListener('click', function() {
        if (window.cookieConsentManager && typeof window.cookieConsentManager.resetConsent === 'function') {
          window.cookieConsentManager.resetConsent();
        } else {
          localStorage.removeItem('cookie_consent');
          location.reload();
        }
      });
    }
  });
</script>
