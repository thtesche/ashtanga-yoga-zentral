---
interface Props {
  title?: string;
  buttonLabel: string;
}

const { title = "Cookie Settings", buttonLabel } = Astro.props;
---

<div class="cookie-reset-box">
  <p>
    <button
      id="reset-cookie-consent"
      class="cookie-reset-link"
      aria-label={buttonLabel}>{buttonLabel}</button
    >
  </p>
</div>

<style>
.cookie-reset-box {
  margin-top: 1rem;
  padding: 1rem;
  background-color: var(--color-bg, #f8f5f0);
  border: 1px solid var(--color-border, #e8e3dd);
  border-radius: 8px;
}

.cookie-reset-box p {
  margin-bottom: 0;
}

.cookie-reset-link {
  background: none;
  border: none;
  padding: 0;
  font: inherit;
  color: var(--color-primary, #637b69);
  text-decoration: underline;
  cursor: pointer;
}

.cookie-reset-link:hover {
  color: var(--color-primary-hover, #4c6051);
}
</style>

<script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    const btn = document.getElementById("reset-cookie-consent");
    if (btn) {
      btn.addEventListener("click", function () {
        if (
          window.cookieConsentManager &&
          typeof window.cookieConsentManager.resetConsent === "function"
        ) {
          window.cookieConsentManager.resetConsent();
        } else {
          localStorage.removeItem("cookie_consent");
          location.reload();
        }
      });
    }
  });
</script>
